rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Institutes collection: public read to discover institutions during sign-up, authenticated write
    match /institutes/{instituteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Announcements collection: authenticated read and write (scoped by institute)
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // User data persistence: saved books, bookmarks, history
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/reading_history/{historyId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/reading_goals/{goalId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Meetings collection: public read to attend/view lectures, creation and updates for authenticated users
    match /meetings/{meetingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // AI Conversations & Messages persisted in Firestore
    match /ai_conversations/{convId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Voice Conversations & Live API logs
    match /voice_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Audio Transcriptions
    match /transcriptions/{transcriptionId} {
      allow read, write: if isAuthenticated();
    }

    // Generated Music tracks (Lyria)
    match /generated_music/{musicId} {
      allow read, write: if isAuthenticated();
    }

    // General app collections (public reads for books & categories)
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Lectures & Visual Study Media: videos and pictures uploaded by admins
    match /lectures/{lectureId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
